# PostgreSQL pooled URL for the API. Never use a VITE_ prefix for secrets.
DATABASE_URL=postgresql://eventpass:local-only@localhost:5432/eventpass
# Direct PostgreSQL connection for migrations, admin operations, backup and restore.
DATABASE_URL_UNPOOLED=postgresql://eventpass:local-only@localhost:5432/eventpass
# Disposable test database only. Tests create and remove random ep_test_* schemas.
TEST_DATABASE_URL=postgresql://eventpass:local-only@localhost:5432/eventpass_test
WEB_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3333
SESSION_TTL_HOURS=12
# COOKIE_SECURE=true in production (enforced). Configure WEB_ORIGIN to the deployment URL.
