# API
API_PORT=3333
API_HOST=127.0.0.1
# Origem permitida pelo CORS (frontend em desenvolvimento)
WEB_ORIGIN=http://localhost:5173

# Banco de dados
# sqlite (padrão, versão de referência): caminho do arquivo, relativo a apps/api
DATABASE_DIALECT=sqlite
DATABASE_URL=./data/eventpass.db
# postgres (homologação Neon/Netlify): cole a string de conexão do console do Neon
# NUNCA comite a string real — este arquivo é só um exemplo.
# DATABASE_DIALECT=postgres
# DATABASE_URL=postgres://usuario:senha@ep-xxx-pooler.region.aws.neon.tech/eventpass?sslmode=require
# Migrações automáticas na inicialização (padrão: false em produção, true no resto).
# Em produção prefira aplicar manualmente: npm run db:migrate
# DB_AUTO_MIGRATE=false
# TLS obrigatório no Neon; false só para Postgres local sem TLS
# DATABASE_SSL=true

# Sessão administrativa
SESSION_TTL_HOURS=12
# Cookie com flag Secure (padrão: true em produção, false no resto)
# COOKIE_SECURE=true

# Testes de integração Postgres (banco DESCARTÁVEL — nunca o homolog)
# PG_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
# PG_TEST_SSL=false

# Notificações: todas DESABILITADAS por padrão. Nunca usar chaves reais neste arquivo.
# EMAIL_ENABLED=false
# TICKET_RECOVERY_ENABLED=false
# EMAIL_PUBLIC_BASE_URL=https://seu-dominio-verificado.example
# EMAIL_ENCRYPTION_KEY=base64-de-32-bytes-gerados-em-ambiente-seguro
# EMAIL_FROM=EventPass <ingressos@seu-dominio.example>
# RESEND_API_KEY=definir-somente-no-servidor

# Explicit allocation of this app's share of the provider account. Zero blocks delivery.
# Include all account consumers when allocating. Never increase above available balance.
EMAIL_DAILY_BUDGET=0
EMAIL_MONTHLY_BUDGET=0
# Daily 03:17 UTC retention function, requires approved deployment + explicit enablement.
EMAIL_MAINTENANCE_ENABLED=false

# Only true after verifying the account balance, other consumers and this allocation.
EMAIL_BUDGET_CONFIRMED=false
